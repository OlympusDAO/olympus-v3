{
    "name": "olympus-v3",
    "author": "OlympusDAO",
    "version": "1.0.0",
    "description": "Olympus V3 contracts",
    "homepage": "https://github.com/OlympusDAO/olympus-v3/blob/main/README.md",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OlympusDAO/olympus-v3.git"
    },
    "engines": {
        "node": ">=24",
        "npm": "use-pnpm",
        "yarn": "use-pnpm",
        "pnpm": ">=11.13.0"
    },
    "scripts": {
        "postinstall": "./shell/postinstall.sh",
        "build": "forge build",
        "prettier": "prettier --no-error-on-unmatched-pattern --write 'src/**/*.sol' '**/*.html' '.*/**/*.{sh,json,yaml,yml,toml}' '**/*.{sh,json,yaml,yml,toml}'",
        "prettier:list": "prettier --no-error-on-unmatched-pattern --list-different 'src/**/*.sol' '**/*.html' '.*/**/*.{sh,json,yaml,yml,toml}' '**/*.{sh,json,yaml,yml,toml}'",
        "prettier:check": "prettier --no-error-on-unmatched-pattern --check 'src/**/*.sol' '**/*.html' '.*/**/*.{sh,json,yaml,yml,toml}' '**/*.{sh,json,yaml,yml,toml}'",
        "forge-lint": "forge lint",
        "forge-lint:check": "forge lint",
        "markdownlint": "markdownlint --dot --fix '**/*.md'",
        "markdownlint:check": "markdownlint --dot '**/*.md'",
        "lint": "pnpm run prettier && pnpm run forge-lint && pnpm run markdownlint",
        "lint:check": "pnpm run prettier:check && pnpm run forge-lint:check && pnpm run markdownlint:check",
        "format:snapshots": "prettier --no-error-on-unmatched-pattern --write 'snapshots/**/*.json'",
        "test": "./shell/test_all.sh",
        "test:unit": "bash ./shell/test_forge.sh --no-match-test '^invariant_' --no-match-contract '(Fork|Script)' --no-match-path '{src/test/proposals/*.t.sol,src/test/deprecated/**}' -vv",
        "test:invariant": "bash ./shell/test_forge.sh --match-test '^invariant_' --no-match-contract '(Fork|Script)' --no-match-path '{src/test/proposals/*.t.sol,src/test/deprecated/**}' -vv",
        "test:fork": "bash ./shell/test_forge.sh --match-contract 'Fork' --no-match-contract 'TokenPoolFork' --no-match-path 'src/test/deprecated/**' --fork-url mainnet -vv",
        "test:fork:loan-consolidator": "bash ./shell/test_forge.sh --match-contract 'LoanConsolidatorFork' --no-match-path 'src/test/deprecated/**' --fork-url mainnet -vv",
        "test:fork:boosted-liquidity": "bash ./shell/test_forge.sh --match-contract 'BLVault.*Fork|BLVaultManager.*Fork' --no-match-path 'src/test/deprecated/**' --fork-url mainnet -vv",
        "test:fork:proposal-helpers": "bash ./shell/test_forge.sh --match-contract 'ConvertibleDepositActivatorFork|MigrationProposalHelperFork' --no-match-path 'src/test/deprecated/**' --fork-url mainnet -vv",
        "test:fork:misc": "bash ./shell/test_forge.sh --match-contract 'Fork' --no-match-contract 'TokenPoolFork|LoanConsolidatorFork|BLVault.*Fork|BLVaultManager.*Fork|ConvertibleDepositActivatorFork|MigrationProposalHelperFork' --no-match-path 'src/test/deprecated/**' --fork-url mainnet -vv",
        "test:proposal": "bash ./shell/test_forge.sh --match-path 'src/test/proposals/*.t.sol' --no-match-contract 'Fork' --fork-url mainnet -vv",
        "test:crosschainfork": "bash ./shell/test_forge.sh --match-contract 'TokenPoolFork' --no-match-path 'src/test/deprecated/**' -vv",
        "test:deprecated": "bash ./shell/test_forge.sh --match-path 'src/test/deprecated/**' -vv",
        "size": "forge clean && forge build --sizes --skip 'src/test/*' --skip 'src/scripts/*'",
        "metrics": "node shell/metrics.js",
        "anvil:fork": "anvil --fork-url mainnet --port 8545 --auto-impersonate"
    },
    "devDependencies": {
        "ajv": "^8.20.0",
        "glob": "^13.0.6",
        "markdownlint-cli": "^0.49.0",
        "prettier": "^3.0.3",
        "prettier-plugin-sh": "^0.14.0",
        "prettier-plugin-solidity": "^1.0.0-beta.19",
        "prettier-plugin-sort-json": "^4.0.0",
        "prettier-plugin-toml": "^2.0.6",
        "solidity-code-metrics": "^0.0.25"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": false,
        "bracketSpacing": false,
        "printWidth": 100,
        "plugins": [
            "prettier-plugin-solidity",
            "prettier-plugin-sh",
            "prettier-plugin-sort-json",
            "prettier-plugin-toml"
        ],
        "jsonRecursiveSort": true
    },
    "packageManager": "pnpm@11.13.0"
}
