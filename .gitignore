# Deployment
# Deny-by-default, then re-open an allowlist of deployment scripts.
# Order is essential: every negation must precede the deny block at
# the bottom, and each directory level must be re-included before git
# will descend into it.
broadcast/**

# Allowlisted scripts. Names must match the .sol filename exactly.
!broadcast/DeployUsdsMocks.sol/**/run-*.json
!broadcast/DeployV2.sol/**/run-*.json
!broadcast/DeployV3.s.sol/**/run-*.json
!broadcast/L2Deploy.s.sol/**/run-*.json
!broadcast/LZBridgeTestnetDeploy.s.sol/**/run-*.json

# Deny block. Must stay last.
broadcast/**/31337/
broadcast/**/*-latest.json
broadcast/**/dry-run/
broadcast/multi/

src/test/sim/in/*.json
src/test/sim/out/*.json
src/test/sim/sims/*.t.sol
.env_deploy*
docs/
# Written by shell/test_coverage.sh
coverage/
lcov.info
coverage.log
genhtml.log
/solidity-metrics.html
dependencies/

.idea

# Override any global ignore rules for LLM tools
!AGENTS.md
!CLAUDE.md
!.claude/
.claude/settings.local.json
